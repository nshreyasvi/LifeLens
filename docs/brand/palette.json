{
  "name": "LifeLens palette",
  "version": 1,
  "method": "WCAG 2.x contrast from sRGB relative luminance; OKLab/OKLCH; Machado-Oliveira-Fernandes 2009 CVD simulation at severity 1.0.",
  "rules": {
    "body_text_min": 4.5,
    "ui_and_large_text_min": 3.0,
    "white_on_accent_min": 4.5
  },
  "brand": {
    "accent": {
      "hex": "#165DFF",
      "name": "Lens Blue",
      "note": "Main accent. Meta-blue family (#0866FF) pushed slightly more electric: OKLCH chroma 0.249 vs 0.240, hue 263 vs 261, and more headroom for white text (5.19:1 vs 4.82:1). Same value in both themes."
    },
    "accent-bright": {
      "hex": "#3D8BFF",
      "name": "Lens Blue Bright",
      "note": "Gradient start and non-text highlights only (white on it is 3.31:1, below the text minimum)."
    },
    "secondary": {
      "hex": "#FF5A36",
      "name": "Signal Coral",
      "note": "Secondary accent for the lights/music side and 'live' moments (also the pupil in the logo). Put dark ink (#10131A) on it, never white (3.10:1)."
    },
    "secondary-strong": {
      "hex": "#C43A17",
      "name": "Signal Coral Deep",
      "note": "Use when white text must sit on coral, and for coral text on light backgrounds."
    },
    "gradient": {
      "css": "linear-gradient(135deg, #3D8BFF 0%, #165DFF 100%)",
      "note": "Logo disc and hero moments. White text on it only as large text (>= 24px, or >= 18.66px bold), or keep it over the #165DFF end."
    }
  },
