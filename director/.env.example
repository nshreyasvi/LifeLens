# Meta Muse Spark is the default (put your key below). MODEL_PROVIDER=ollama uses a local Llama 3.2 instead: pull it yourself.
MODEL_PROVIDER=muse
OLLAMA_MODEL=llama3.2:3b

# Optional Meta Model API provider. The key is read only from director/.env.
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_API_KEY=
