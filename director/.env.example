# Local Ollama is the default. Copy this file to .env and pull the model yourself.
MODEL_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
PREDICTOR=stub

# Optional Meta Model API provider. The key is read only from director/.env.
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_API_KEY=
